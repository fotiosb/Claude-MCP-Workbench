# MCP Workbench v1 — copy to .env (local) or /etc/mcp-workbench.env (deploy).
# Defaults work on local Windows/Linux. Production values are noted.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional default effort for Claude briefs (low|medium|high). UI at /settings overrides.
ANTHROPIC_EFFORT=medium
# Optional HMAC secret for the /settings admin cookie. If unset, one is generated
# once into DATA_DIR/session_secret. Settings UI (password + llm_settings.json) overrides
# ANTHROPIC_* at runtime without restart.
# SETTINGS_SESSION_SECRET=

# Primary public URL. PUBLIC_BASE_URL is accepted as an alias.
APP_BASE_URL=http://127.0.0.1:8000

MCP_SERVER_NAME=mcp-workbench

# Local: ./data/{db,clones,artifacts,cache}
# Production: /var/lib/mcp-workbench/{db,clones,artifacts,cache}
DATA_DIR=./data
CLONE_DIR=./data/clones

MAX_CLONE_BYTES=157286400
MAX_FILES=8000
MAX_CONCURRENT_PER_IP=1
DAILY_RUNS_PER_IP=8
DAILY_LLM_CALLS_PER_IP=20
ELICIT_FILE_THRESHOLD=1500
ELICIT_WAIT_SECONDS=300
CACHE_TTL_HOURS=6
WARM_EXAMPLES=1
ARTIFACT_TTL_HOURS=24
HOST=127.0.0.1
PORT=8000
# 0 for local preview (ignore X-Real-IP). Set 1 only behind nginx.
TRUSTED_PROXY=0

# Optional extras (still read by config.py)
# PUBLIC_BASE_URL=https://workbench.example.com
# DATABASE_PATH=./data/db/workbench.db
# CLONE_WALL_SECONDS=60
# CLONE_WALL_SECONDS_WARM=90
# MAX_READ_BYTES=262144
# MAX_URL_LENGTH=512
# LOG_LEVEL=INFO
